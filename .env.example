# WebSocket URL for the agent backend (browser-visible — must use NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_WS_URL=ws://localhost:4747/ws

# GitHub Pages static demo: in-browser mock agent (no live WebSocket server)
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_WS_URL=demo://agent

# Optional: HTTP health URL for scripts (not used by the Next.js app directly)
AGENT_SERVER_HEALTH_URL=http://localhost:4747/health

# Live Incident Desk. Leave unset to play the labeled replay.
# Create a key in Nebius Token Factory. Do not prefix this with NEXT_PUBLIC_.
NEBIUS_API_KEY=
# Optional. Defaults to https://api.tokenfactory.nebius.com/v1
NEBIUS_BASE_URL=
# Optional. Defaults to nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL=

# Optional Tavily web_search tool. Leave unset and the tool returns a clear error.
TAVILY_API_KEY=
