# WebSocket URL for the agent backend (browser-visible — must use NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_WS_URL=ws://localhost:4747/ws

# GitHub Pages static demo: in-browser mock agent (no live WebSocket server)
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_WS_URL=demo://agent

# Optional: HTTP health URL for scripts (not used by the Next.js app directly)
AGENT_SERVER_HEALTH_URL=http://localhost:4747/health
