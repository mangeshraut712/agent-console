{
  "name": "agent-console",
  "version": "1.2.1",
  "description": "Incident Desk — Nemotron plans on-call investigations, with a live trace and a seeded replay",
  "type": "module",
  "license": "MIT",
  "author": "Mangesh Raut",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mangeshraut712/agent-console.git"
  },
    "homepage": "https://mangeshraut712.github.io/agent-console/",
  "bugs": {
    "url": "https://github.com/mangeshraut712/agent-console/issues"
  },
  "scripts": {
    "setup": "npm ci && npm ci --prefix agent-server && npm run build --prefix agent-server",
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:pages": "node scripts/export-pages.mjs",
    "deploy": "docker compose up --build -d",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:server": "node scripts/verify-agent-server.mjs",
    "verify:chaos": "node scripts/verify-agent-server.mjs --mode chaos",
    "capture:screenshots": "node scripts/capture-submission.mjs --mode screenshots",
    "capture:chaos-video": "node scripts/capture-submission.mjs --mode chaos-video",
    "typecheck": "tsc --noEmit",
    "stack": "docker compose up --build",
    "stack:down": "docker compose down"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "typescript": "5.8.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.5",
    "playwright": "^1.52.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
